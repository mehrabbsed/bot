    parts = message.text.split(maxsplit=1) if message.text else []
    if len(parts) < 2 or not parts[1].strip():
        await message.reply_text("استفاده: /unfilter کلمه")
        return
    word = parts[1].strip().casefold()
    chat_id = str(chat.id)
    words = data["filters"].setdefault(chat_id, [])
    if word not in words:
        await message.reply_text("این عبارت در فهرست فیلترها نیست.")
