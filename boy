    try:
        photo_file = await replied.photo[-1].get_file()
        buf = io.BytesIO()
        await photo_file.download_to_memory(buf)
        buf.seek(0)
        original_size = len(buf.getvalue())

        def _compress():
            img = Image.open(buf).convert("RGB")
            if max(img.size) > 1600:
