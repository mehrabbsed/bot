def _classify_text(text: str) -> str:
    t = text.casefold()
    if any(w in t for w in ("سلام", "درود", "hi", "hello", "hey", "صبح بخیر", "شب بخیر")):
        return "greeting"
    if any(w in t for w in ("خوبی", "چطوری", "حالت", "how are", "چه خبر")):
        return "how_are_you"
    if any(w in t for w in ("ممنون", "مرسی", "تشکر", "thanks", "thank")):
        return "thanks"
    if any(w in t for w in ("خداحافظ", "خدانگهدار", "بای", "bye", "خدافظ")):
        return "farewell"
    if any(w in t for w in ("دوستت دارم", "عاشقتم", "love")):
        return "love"
    if any(w in t for w in ("احمق", "خنگ", "کثافت", "fuck", "stupid", "idiot")):
        return "insult"
    if "?" in text or "؟" in text or any(t.startswith(w) for w in ("چی", "چرا", "کی", "کجا", "چطور", "آیا")):
        return "question"
    return "general"

def _local_reply(user_text: str) -> str:
    cat = _classify_text(user_text)
    return random.choice(CHATTER_REPLIES.get(cat, CHATTER_REPLIES["general"]))


# ─── فقط API دیپ‌سیک ───
async def generate_chatter_reply(user_text: str, user_name: str) -> str:
    if not DEEPSEEK_API_KEY or "کلید_جدید" in DEEPSEEK_API_KEY:
        logger.warning("⚠️ کلید دیپ‌سیک تنظیم نشده است. استفاده از جواب‌های آماده.")
        return _local_reply(user_text)

    try:
        async with httpx.AsyncClient(timeout=30) as client:
            r = await client.post(
                "https://api.deepseek.com/v1/chat/completions",
                headers={"Authorization": f"Bearer {DEEPSEEK_API_KEY}"},
                json={
                    "model": "deepseek-chat",
                    "messages": [
                        {"role": "system", "content": CHATTER_SYSTEM_PROMPT},
                        {"role": "user", "content": f"کاربر «{user_name}» نوشت: «{user_text[:500]}»"},
                    ],
                    "max_tokens": 150,
                    "temperature": 0.95,
                },
            )
            if r.status_code == 200:
                d = r.json()
                text = d["choices"][0]["message"]["content"].strip()
                if text and len(text) < 600:
                    logger.info("✅ جواب از DeepSeek")
                    return text
                else:
                    logger.warning("DeepSeek جواب خالی یا طولانی داد.")
            else:
                logger.warning(f"DeepSeek HTTP {r.status_code}: {r.text[:150]}")
    except Exception as e:
        logger.warning(f"DeepSeek استثنا: {e}")
    
    # اگه خطا داد
    logger.info("⚠️ خطا در DeepSeek → جواب آماده")
    return _local_reply(user_text)


