async def on_message_edited(update, context):
    message = update.edited_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if user.is_bot:
        return

    new_text = message.text or message.caption or ""
    if not new_text:
        return

    key = (chat.id, message.message_id)
    old_text = _message_cache.get(key)

    if old_text is None:
        _message_cache[key] = new_text
        return

    if old_text == new_text:
        _message_cache[key] = new_text
        return

    await notify_edit(context, chat, user, old_text, new_text)
    _message_cache[key] = new_text


