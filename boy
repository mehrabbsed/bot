async def add_filter(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return

    text = message.text or ""
    if text.startswith("/filter"):
        parts = text.split(maxsplit=1)
    elif text.startswith("فیلتر"):
        parts = text.split(maxsplit=1)
    else:
        return

    if len(parts) < 2 or not parts[1].strip():
        await message.reply_text("استفاده: `/filter کلمه` یا `فیلتر کلمه`")
        return

    word = parts[1].strip().casefold()
    chat_id = str(chat.id)
    data["filters"].setdefault(chat_id, [])

    if word in data["filters"][chat_id]:
        await message.reply_text(f"⚠️ عبارت «{word}» از قبل فیلتر شده است.")
        return

    data["filters"][chat_id].append(word)
    save_data()
    await message.reply_text(f"✅ عبارت «{word}» به لیست فیلترها اضافه شد.\n\n📊 تعداد فیلترها: {len(data['filters'][chat_id])}")


