_admin_cache = {}
_ADMIN_CACHE_TTL = 600


async def get_cached_admin_ids(chat_id, context):
    now = time.time()
    cached = _admin_cache.get(chat_id)
    if cached and (now - cached[1]) < _ADMIN_CACHE_TTL:
        return cached[0]
    try:
        admins = await context.bot.get_chat_administrators(chat_id)
        admin_ids = [a.user.id for a in admins if not a.user.is_bot]
        _admin_cache[chat_id] = (admin_ids, now)
        return admin_ids
    except TelegramError as e:
        logger.error(f"❌ خطا در گرفتن ادمین‌ها: {e}")
        return cached[0] if cached else []


