def default_locks():
    return {
        "messages": False, "photo": False, "video": False,
        "link": False, "media": False, "forward": False,
    }


def get_locks(chat_id):
    key = chat_key(chat_id)
    if key not in data["locks"]:
        data["locks"][key] = default_locks()
    else:
        for name, value in default_locks().items():
            data["locks"][key].setdefault(name, value)
    return data["locks"][key]


def make_permissions(chat_id):
    locks = get_locks(chat_id)
    can_send = not locks["messages"]
    return ChatPermissions(
        can_send_messages=can_send,
        can_send_audios=can_send and not locks["media"],
        can_send_documents=can_send and not locks["media"],
        can_send_photos=can_send and not locks["photo"],
        can_send_videos=can_send and not locks["video"],
        can_send_video_notes=can_send and not locks["media"],
        can_send_voice_notes=can_send and not locks["media"],
        can_send_polls=can_send,
        can_send_other_messages=can_send and not locks["media"],
        can_add_web_page_previews=can_send and not locks["link"],
    )


URL_RE = re.compile(r"(?:https?://|www\.|t\.me/|telegram\.me/|tg://)\S*", re.IGNORECASE)


async def check_link_lock(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if user.is_bot:
        return
    locks = get_locks(chat.id)
    if not locks["link"]:
        return
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        pass
    has_link = False
    all_entities = list(message.entities or []) + list(message.caption_entities or [])
    for ent in all_entities:
        if ent.type in ("url", "text_link"):
            has_link = True
            break
    if not has_link:
        text = message.text or message.caption or ""
        if URL_RE.search(text):
            has_link = True
    if not has_link:
        return
    await notify_delete(context, chat, user, message, "ارسال لینک (قفل لینک)")
    try:
        await message.delete()
    except TelegramError:
        pass
    ck = chat_key(chat.id)
    uk = user_key(user.id)
    data["warns"].setdefault(ck, {})
    current = int(data["warns"][ck].get(uk, 0))
    new_count = current + 1
    if new_count == 1:
        data["warns"][ck][uk] = 1
        bump_daily_stat(chat.id, "warns")
        warn_text = "زهر اول: اولین قطره‌ی زهر وارد پرونده شد. 🥀\n\n🚫 ارسال لینک ممنوع!"
    elif new_count == 2:
        data["warns"][ck][uk] = 2
        bump_daily_stat(chat.id, "warns")
        warn_text = "🦂 زهر دوم: یک قدم تا حذف. ☠️\n\n🚫 ارسال لینک ممنوع!"
    else:
        try:
            await context.bot.ban_chat_member(chat.id, user.id)
            data["warns"][ck][uk] = 0
            bump_daily_stat(chat.id, "leaves")
            warn_text = "🦂 زهر سوم: اخراج شدی! ⚖️\n\n🚫 ارسال لینک ممنوع!"
            data["banned"].setdefault(ck, {})
            data["banned"][ck][uk] = {
                "reason": "ارسال لینک مکرر",
                "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
            }
        except TelegramError as e:
            logger.exception(f"{e}")
            warn_text = "❌ خطا."
    save_data()
    final_count = int(data["warns"].get(ck, {}).get(uk, 0))
    wd = f"⚠️ اخطار: {final_count} از ۳\n" if final_count > 0 else ""
    full_text = f"{warn_text}\n\n{wd}👤 {user.mention_html()}\n🆔 <code>{user.id}</code>"
    try:
        await context.bot.send_message(chat.id, full_text, parse_mode="HTML")
    except TelegramError as e:
        logger.exception(f"{e}")
    raise ApplicationHandlerStop


async def check_forward_lock(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if user.is_bot:
        return
    locks = get_locks(chat.id)
    if not locks.get("forward", False):
        return
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        pass
    is_forward = (
        getattr(message, "forward_origin", None) is not None
        or getattr(message, "forward_from", None) is not None
        or getattr(message, "forward_from_chat", None) is not None
        or getattr(message, "forward_sender_name", None) is not None
    )
    if not is_forward:
        return
    await notify_delete(context, chat, user, message, "ارسال فوروارد (قفل فوروارد)")
    try:
        await message.delete()
    except TelegramError:
        pass
    raise ApplicationHandlerStop


async def apply_locks(chat, context):
    try:
        await context.bot.set_chat_permissions(
            chat_id=chat.id,
            permissions=make_permissions(chat.id),
            use_independent_chat_permissions=True,
        )
    except TelegramError as e:
        logger.error(f"خطا: {e}")


