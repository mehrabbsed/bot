async def check_filter(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if user.is_bot:
        return
    if not message.text:
        return
    if message.text.startswith(("/anon", "ناشناس", "پیام مخفی", "/", "تگ")):
        return

    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        return

    text_to_check = message.text.casefold()
    for word in data["filters"].get(str(chat.id), []):
        if word and word in text_to_check:
            try:
                await message.delete()
            except TelegramError:
                pass
            return

    ck = chat_key(chat.id)
    uk = user_key(user.id)

    data.setdefault("last_messages", {})
    last_msg = data["last_messages"].get(f"{ck}:{uk}")

    if last_msg and last_msg.lower() == message.text.lower():
        data["warns"].setdefault(ck, {})
        current = int(data["warns"][ck].get(uk, 0))
        new_count = current + 1

        if new_count == 1:
            data["warns"][ck][uk] = 1
            warn_text = (
                "زهر اول: اولین قطره‌ی زهر وارد پرونده شد؛ دفعه‌ی بعد، عواقبش با خودته. 🥀\n\n"
                f"⚠️ اخطار: 1 از ۳\n"
                f"👤 کاربر: {user.mention_html()}\n"
                f"🆔 آیدی: <code>{user.id}</code>"
            )
        elif new_count == 2:
            data["warns"][ck][uk] = 2
            warn_text = (
                "🦂 زهر دوم: زهر دوم هم ثبت شد؛ فقط یک قدم تا حذف از این قلمرو فاصله داری. ☠️\n\n"
                f"⚠️ اخطار: 2 از ۳\n"
                f"👤 کاربر: {user.mention_html()}\n"
                f"🆔 آیدی: <code>{user.id}</code>"
            )
        else:
            try:
                await context.bot.ban_chat_member(chat.id, user.id)
                data["warns"][ck][uk] = 0
                warn_text = (
                    "🦂 زهر سوم: سه قطره زهر، یک حکم قطعی! ⚖️\n"
                    "🚫 مهلتت تموم شد؛ از این قلمرو اخراج شدی.\n\n"
                    f"👤 کاربر: {user.mention_html()}\n"
                    f"🆔 آیدی: <code>{user.id}</code>"
                )
            except TelegramError as e:
                logger.exception(f"خطا در بن: {e}")
                warn_text = f"❌ خطا در اجرای حکم: {e}"

        try:
            await message.delete()
        except TelegramError:
            pass

        try:
            await message.reply_text(warn_text, parse_mode="HTML")
        except TelegramError:
            try:
                await context.bot.send_message(chat.id, warn_text, parse_mode="HTML")
            except TelegramError as e:
                logger.exception(f"خطا در ارسال هشدار: {e}")

        save_data()
        data["last_messages"][f"{ck}:{uk}"] = None
    else:
        data["last_messages"][f"{ck}:{uk}"] = message.text
        save_data()


