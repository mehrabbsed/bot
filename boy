            out.seek(0)
            return out
        compressed_buf = await asyncio.to_thread(_compress)
        compressed_size = len(compressed_buf.getvalue())
        ratio = (1 - compressed_size / original_size) * 100
        await message.reply_document(
            document=compressed_buf,
            filename="compressed.jpg",
            caption=f"📉 {original_size//1024} KB → {compressed_size//1024} KB\nکاهش: {ratio:.1f}%",
        )
        await status.delete()
    except Exception as e:
