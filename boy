async def set_quiet(update: Update, context: ContextTypes.DEFAULT_TYPE, enabled: bool) -> None:
    chat = update.effective_chat
    message = update.effective_message
    if not chat or not message:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("این دستور فقط در گروه قابل استفاده است.")
        return
    if not await require_admin(update, context):
        return
    locks = get_locks(chat.id)
    locks["quiet"] = enabled
    save_data()
    await apply_locks(chat, context)
    await message.reply_text("🔇 حالت سکوت گروه فعال شد." if enabled else "🔊 حالت سکوت گروه غیرفعال شد.")


async def quiet_on(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await set_quiet(update, context, True)


async def quiet_off(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await set_quiet(update, context, False)


async def date_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    if not message:
        return

    now = datetime.now()
    jalali = jdatetime.datetime.fromgregorian(datetime=now)

    jalali_weekdays = ["شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه"]
    gregorian_weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

    jalali_months = [
        "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
        "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
    ]

    gregorian_months = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ]

    jalali_date = (
        f"{jalali_weekdays[jalali.weekday()]} "
        f"{jalali.day} {jalali_months[jalali.month - 1]} {jalali.year}"
    )

    gregorian_date = (
        f"{gregorian_weekdays[now.weekday()]} "
        f"{now.day} {gregorian_months[now.month - 1]} {now.year}"
    )

    time_str = now.strftime("%H:%M:%S")

    text = (
        "📅 **تاریخ و ساعت**\n\n"
        f"🇮🇷 **شمسی:** {jalali_date}\n"
        f"📆 `{jalali.strftime('%Y/%m/%d')}`\n\n"
        f"🌍 **میلادی:** {gregorian_date}\n"
        f"📆 `{now.strftime('%Y/%m/%d')}`\n\n"
        f"🕒 **ساعت:** `{time_str}`"
    )

    await message.reply_text(text, parse_mode="Markdown")

async def fal_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not await require_admin(update, context):
        return

    message = update.effective_message
    if not message:
        return
    try:
        if not Path("fales.json").exists():
            await message.reply_text("⚠️ فایل فال‌ها (fales.json) پیدا نشد!")
            return
        fales = json.loads(Path("fales.json").read_text(encoding="utf-8"))
        if not fales:
            await message.reply_text("⚠️ فایل فال‌ها خالی است!")
            return
        chosen = random.choice(fales)

        # ۶ بیت = ۱۲ مصرع
        poem_lines = [line.strip() for line in chosen["poem"].split("\n") if line.strip()]
        six_lines = poem_lines[:12]
        poem_text = "\n".join(six_lines)

        # لاگ برای دیباگ
        logger.info(f"FAL: {len(poem_lines)} lines found, showing {len(six_lines)}")

        text = (
            "📜 فال حافظ 📜\n\n"
            f"{poem_text}\n\n"
            "──────────────\n\n"
            f"🔮 تعبیر: {chosen['tafsir']}"
        )
        await message.reply_text(text)   # بدون parse_mode
    except Exception as e:
        logger.error(f"خطا در خواندن فال: {e}")
        await message.reply_text("❌ خطایی در خواندن فال رخ داد.")


