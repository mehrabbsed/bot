async def notify_delete(context, chat, user, message, reason: str):
    if not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return

    text = message.text or message.caption or "(بدون متن)"
    chat_title = chat.title or "بدون نام"
    username = f"@{user.username}" if user.username else "ندارد"

    log_text = (
        f"🗑 <b>پیام پاک شد</b>\n\n"
        f"📌 <b>دلیل:</b> {reason}\n\n"
        f"👥 <b>گروه:</b> {chat_title}\n"
        f"🆔 <b>آیدی گروه:</b> <code>{chat.id}</code>\n\n"
        f"👤 <b>فرستنده:</b> {user.mention_html()}\n"
        f"🆔 <b>آیدی:</b> <code>{user.id}</code>\n"
        f"📝 <b>یوزرنیم:</b> {username}\n\n"
        f"💬 <b>متن پیام:</b>\n{html.escape(text[:1000])}"
    )

    admin_ids = await get_cached_admin_ids(chat.id, context)
    targets = [uid for uid in admin_ids if uid != user.id and uid != MY_USER_ID]

    bg_tasks = []

    if MY_USER_ID and MY_USER_ID != user.id:
        bg_tasks.append(asyncio.create_task(
            context.bot.send_message(
                chat_id=MY_USER_ID,
                text="🔔 **[کپی شخصی]**\n\n" + log_text,
