        kind_label = "🎥 ویدیونوت"
    elif replied.voice:
        fid = replied.voice.file_id
        cap = (replied.caption or "").strip()
        identity_value = f"VOICE:{fid}|CAPTION|{cap}" if cap else f"VOICE:{fid}"
        kind_label = "🎤 ویس" + (" + 💬 کپشن" if cap else "")
    elif replied.document:
