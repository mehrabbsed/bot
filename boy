async def _send_stats(update, context):
    """هسته آمار — بدون چک ادمین"""
    chat = update.effective_chat
    if not chat:
        return

    # تعیین مقصد ارسال
    send_to = None
    if update.callback_query and update.callback_query.message:
        send_to = update.callback_query.message.chat_id
    elif update.effective_message:
        send_to = update.effective_message.chat_id
    if not send_to:
        return

    ck = chat_key(chat.id)
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    daily = data.get("daily_stats", {}).get(ck, {})
    today_stats = daily.get(today, {})

    logger.info(f"🔍 آمار {ck} در {today}: messages={today_stats.get('messages', 0)} | photos={today_stats.get('photos', 0)} | voices={today_stats.get('voices', 0)} | videos={today_stats.get('videos', 0)} | warns={today_stats.get('warns', 0)}")

    jalali = jdatetime.datetime.fromgregorian(datetime=now)
    jw = ["شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه"]
    jm = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
          "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"]
    jd = f"{jw[jalali.weekday()]} {jalali.day} {jm[jalali.month-1]} {jalali.year}"

    hour_now = now.strftime("%H:%M")
    hourly = today_stats.get("hourly", [0] * 24)
    if hourly and max(hourly) > 0:
        best_hour = hourly.index(max(hourly))
        peak_text = f"🕐 ساعت {best_hour:02d}:00 ({max(hourly)} پیام)"
    else:
