def default_locks():
    return {"messages": False, "photo": False, "video": False, "link": False, "media": False, "quiet": False}


def get_locks(chat_id):
    key = chat_key(chat_id)
    if key not in data["locks"]:
        data["locks"][key] = default_locks()
    else:
        for name, value in default_locks().items():
            data["locks"][key].setdefault(name, value)
    return data["locks"][key]


def make_permissions(chat_id):
    locks = get_locks(chat_id)
    can_send = not (locks["messages"] or locks["quiet"])
    return ChatPermissions(
        can_send_messages=can_send,
        can_send_audios=can_send and not locks["media"],
        can_send_documents=can_send and not locks["media"],
        can_send_photos=can_send and not locks["photo"],
        can_send_videos=can_send and not locks["video"],
        can_send_video_notes=can_send and not locks["media"],
        can_send_voice_notes=can_send and not locks["media"],
        can_send_polls=can_send,
        can_send_other_messages=can_send and not locks["media"],
        can_add_web_page_previews=can_send and not locks["link"],
    )


async def apply_locks(chat, context):
    try:
        await context.bot.set_chat_permissions(
            chat_id=chat.id,
            permissions=make_permissions(chat.id),
            use_independent_chat_permissions=True,
        )
    except TelegramError as e:
        logger.error(f"خطا در اعمال قفل‌ها: {e}")


