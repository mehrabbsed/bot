async def block_unauthorized(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """اگه گروه مجاز نبود، ربات هیچ کاری نکنه"""
    chat = update.effective_chat
    if not chat:
        return

    # توی PV کاری نکن (چون PV برای خودت آزاده)
    if chat.type == ChatType.PRIVATE:
        return

    if not is_allowed_chat(chat.id):
        logger.warning(f"⛔ پیام از گروه غیرمجاز: {chat.id} ({chat.title})")

        # فقط یه بار پیام بده
        if update.effective_message:
            try:
                await update.effective_message.reply_text(
                    "⛔ این ربات فقط توی گروه‌های مجاز کار می‌کنه."
                )
            except TelegramError:
                pass

        # بلاک کن — هیچ هندلر دیگه‌ای اجرا نشه
        raise ApplicationHandlerStop


