async def welcome_new_members(update, context):
    if not update.chat_member:
        return

    cm = update.chat_member
    chat = cm.chat
    member = cm.new_chat_member.user

    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if member.is_bot:
        return

    old = cm.old_chat_member
    new = cm.new_chat_member

    old_is_member = getattr(old, "is_member", False)
    new_is_member = getattr(new, "is_member", False)

    was_outside = (old.status == ChatMemberStatus.LEFT) or (
        old.status == ChatMemberStatus.RESTRICTED and not old_is_member
    )
    is_inside_now = new_is_member or new.status in (
        ChatMemberStatus.MEMBER,
        ChatMemberStatus.ADMINISTRATOR,
        ChatMemberStatus.OWNER,
    )

    if not (was_outside and is_inside_now):
        return

    ck = chat_key(chat.id)
    uk = user_key(member.id)
    join_key = f"{ck}:{uk}"

    now = datetime.now()
    jalali = jdatetime.datetime.fromgregorian(datetime=now)
    date_str = jalali.strftime("%Y/%m/%d")

    previous_join = data["join_dates"].get(join_key)
    is_returning = previous_join is not None

    data["join_dates"][join_key] = date_str
    save_data()

    header = (
        "𐤀 𝐄𝐍𝐉𝐎𝐘 𝐘𝐎𝐔𝐑 𝐒𝐓𝐀𝐘. 🪐\n\n"
        "𓆩 𝐖𝐄𝐋𝐂𝐎𝐌𝐄 𝐓𝐎 𝐄𝐓𝐇𝐄𝐑 𓆪 💜𐤀\n"
    )

    if is_returning:
        body = (
            "یکی دیگه برگشت به جمع، دوباره خوش اومدی عزیزم؛\n"
            "خروجی سمت چپه، ولی معلومه دلش طاقت نیاورد و برگشت. 😭💋\n\n"
            f"👤 کاربر: {member.mention_html()}\n"
            f"🆔 آیدی: <code>{member.id}</code>\n"
            f"📅 اولین عضویت: {previous_join}\n"
            f"📅 تاریخ بازگشت: {date_str}"
        )
    else:
        body = (
            "یکی دیگه هم به جمع اضافه شد، خوش اومدی عزیزم؛\n"
            "خروجی سمت چپه، ولی مطمئنم تا پیداش کنی به ما وابسته شدی. 😭💋\n\n"
            f"👤 کاربر: {member.mention_html()}\n"
            f"🆔 آیدی: <code>{member.id}</code>\n"
            f"📅 تاریخ عضویت: {date_str}"
        )

    try:
        await context.bot.send_message(chat_id=chat.id, text=header + "\n" + body, parse_mode="HTML")
    except TelegramError as e:
        logger.exception(f"خطا در ارسال خوش‌آمد: {e}")


