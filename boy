async def set_quiet(update, context, enabled):
    chat = update.effective_chat
    message = update.effective_message
    if not chat or not message:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("این دستور فقط در گروه قابل استفاده است.")
        return
    if not await require_admin(update, context):
        return
    locks = get_locks(chat.id)
    locks["quiet"] = enabled
    save_data()
    await apply_locks(chat, context)
    await message.reply_text("🔇 حالت سکوت گروه فعال شد." if enabled else "🔊 حالت سکوت گروه غیرفعال شد.")


async def quiet_on(update, context):
    await set_quiet(update, context, True)


async def quiet_off(update, context):
    await set_quiet(update, context, False)


