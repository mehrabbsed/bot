async def welcome_new_members(update, context):
    if not update.chat_member:
        return
    cm = update.chat_member
    chat = cm.chat
    member = cm.new_chat_member.user
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if member.is_bot:
        return
    old = cm.old_chat_member
    new = cm.new_chat_member
    old_is = getattr(old, "is_member", False)
    new_is = getattr(new, "is_member", False)
    was_out = (old.status == ChatMemberStatus.LEFT) or (
        old.status == ChatMemberStatus.RESTRICTED and not old_is)
    is_in = new_is or new.status in (
        ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER)
    if not (was_out and is_in):
        return
    ck = chat_key(chat.id)
    uk = user_key(member.id)
    join_key = f"{ck}:{uk}"
    now = datetime.now()
    jalali = jdatetime.datetime.fromgregorian(datetime=now)
    date_str = jalali.strftime("%Y/%m/%d")
    prev = data["join_dates"].get(join_key)
    is_ret = prev is not None
    data["join_dates"][join_key] = date_str
    bump_daily_stat(chat.id, "joins")
    save_data()
    header = "𐤀 𝐄𝐍𝐉𝐎𝐘 𝐘𝐎𝐔𝐑 𝐒𝐓𝐀𝐘. 🪐\n\n𓆩 𝐖𝐄𝐋𝐂𝐎𝐌𝐄 𝐓𝐎 𝐄𝐓𝐇𝐄𝐑 𓆪 💜𐤀\n"
