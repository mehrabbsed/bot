@admin_only
async def tag_all(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    text = message.text or ""
    custom_text = "📢 توجه!"
    if text.startswith("/tagall"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1:
            custom_text = parts[1].strip()
    elif text.startswith("تگ"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1 and parts[1].strip():
            custom_text = parts[1].strip()
    reply_text = ""
    if message.reply_to_message:
        replied = message.reply_to_message
        if replied.text:
            reply_text = f"\n\n💬 {replied.text[:200]}"
        elif replied.caption:
            reply_text = f"\n\n💬 {replied.caption[:200]}"
    ck = chat_key(chat.id)
    try:
        admins = await context.bot.get_chat_administrators(chat.id)
        admin_ids = {a.user.id for a in admins}
    except TelegramError:
        admin_ids = set()
    uids = set(admin_ids)
    for src in ("message_counts", "join_dates"):
        for key in data.get(src, {}).keys():
            if key.startswith(f"{ck}:"):
                try:
                    uids.add(int(key.split(":", 1)[1]))
                except (ValueError, IndexError):
                    pass
    for src in ("warns", "muted", "banned"):
        for uk in data.get(src, {}).get(ck, {}).keys():
            try:
                uids.add(int(uk))
            except (ValueError, TypeError):
                pass
    for key in data.get("identities", {}).keys():
        if key.startswith(f"{ck}:"):
            try:
                uids.add(int(key.split(":", 1)[1]))
            except (ValueError, IndexError):
                pass
    for uk in data.get("special", {}).get(ck, []):
        try:
            uids.add(int(uk))
        except (ValueError, TypeError):
            pass
    uids.discard(context.bot.id)
    if not uids:
        await reply_and_delete(update, "⚠️ عضوی نیست!")
        return
    mentions = []
    count = 0
    seen = set()
    for uid in uids:
        if uid in seen:
            continue
        seen.add(uid)
        try:
            m = await context.bot.get_chat_member(chat.id, uid)
            if m.user.is_bot:
                continue
            if m.status == ChatMemberStatus.LEFT:
                continue
            if m.status == ChatMemberStatus.RESTRICTED and not getattr(m, "is_member", False):
                continue
            n = (m.user.first_name or "کاربر").replace("[", "").replace("]", "")
            mentions.append(f"[{n}](tg://user?id={uid})")
            count += 1
        except TelegramError:
            continue
        if len(mentions) >= 50:
            try:
                await context.bot.send_message(
                    chat_id=chat.id,
                    text=f"{custom_text}{reply_text}\n\n" + " ".join(mentions),
                    parse_mode="Markdown", disable_web_page_preview=True,
                )
            except TelegramError as e:
                logger.exception(f"{e}")
            mentions = []
    if mentions:
        try:
            await context.bot.send_message(
                chat_id=chat.id,
                text=f"{custom_text}{reply_text}\n\n" + " ".join(mentions),
                parse_mode="Markdown", disable_web_page_preview=True,
            )
        except TelegramError as e:
            logger.exception(f"{e}")
    try:
        await message.delete()
    except TelegramError:
        pass


