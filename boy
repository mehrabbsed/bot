async def member_action(update, context, action):
    if not await require_admin(update, context):
        return
    chat = update.effective_chat
    message = update.effective_message

    if action == "profile" and message and message.text == "👤 پروفایل من":
        target = update.effective_user
    else:
        target = await get_target(update)

    if not target:
        return
    if target.id == context.bot.id:
        await reply_and_delete(update, "😅 این دستور را نمی‌توانم روی خودم اجرا کنم.")
        return
    if target.id == update.effective_user.id and action != "profile":
        await reply_and_delete(update, "⚠️ این دستور را روی خودت اجرا نکن.")
        return

    try:
        if action in ("kick", "ban"):
            try:
                target_member = await context.bot.get_chat_member(chat.id, target.id)
                if target_member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ نمی‌تونی ادمین رو اخراج یا بن کنی!")
                    return
            except TelegramError:
                pass

            await context.bot.ban_chat_member(chat.id, target.id)

            if action == "ban":
                ck_ban = chat_key(chat.id)
                uk_ban = user_key(target.id)
                data["banned"].setdefault(ck_ban, {})
                data["banned"][ck_ban][uk_ban] = {
                    "reason": "بن دستی توسط ادمین",
                    "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
                }
                save_data()

            if action == "kick":
                await context.bot.unban_chat_member(chat.id, target.id, only_if_banned=True)
                answer = (
                    "متهم فکر کرد شخصیت اصلی داستانه. حیف که حتی سیاهی‌لشکر هم نبود.\n\n"
                    f"👤 کاربر: {target.mention_html()}\n"
                    f"🆔 آیدی: <code>{target.id}</code>"
                )
            else:
                answer = (
                    f"🚫 {target.mention_html()} بن شد.\n\n"
                    f"👤 کاربر: {target.mention_html()}\n"
                    f"🆔 آیدی: <code>{target.id}</code>"
                )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unban":
            await context.bot.unban_chat_member(chat.id, target.id, only_if_banned=True)

            ck_ban = chat_key(chat.id)
            uk_ban = user_key(target.id)
            if ck_ban in data["banned"] and uk_ban in data["banned"][ck_ban]:
                del data["banned"][ck_ban][uk_ban]
                if not data["banned"][ck_ban]:
                    del data["banned"][ck_ban]
                save_data()

            answer = (
                "ظاهراً جهنم هم دیگه ظرفیتت رو نداشت. برگرد به قلمرو؛ فعلاً تحملت می‌کنیم. 🥀\n\n"
                f"👤 کاربر: {target.mention_html()}\n"
                f"🆔 آیدی: <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "mute":
            try:
                target_member = await context.bot.get_chat_member(chat.id, target.id)
                if target_member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ نمی‌تونی ادمین رو سکوت کنی!")
                    return
            except TelegramError:
                pass

            minutes = 0
            if context.args:
                raw_minutes = context.args[0]
            else:
                raw_minutes = context.user_data.get("plain_mute_minutes")

            if raw_minutes is not None:
                try:
                    minutes = int(raw_minutes)
                except (ValueError, TypeError):
                    await reply_and_delete(update, "❌ مدت باید عدد باشد؛ مثال: درتوبزار 5")
                    return
                if not 1 <= minutes <= 10080:
                    await reply_and_delete(update, "⚠️ مدت باید بین ۱ تا ۱۰۰۸۰ دقیقه باشد.")
                    return

            until = datetime.now(timezone.utc) + timedelta(minutes=minutes) if minutes else None

            await context.bot.restrict_chat_member(
                chat.id,
                target.id,
                permissions=ChatPermissions(can_send_messages=False),
                until_date=until,
                use_independent_chat_permissions=True,
            )

            ck_mute = chat_key(chat.id)
            uk_mute = user_key(target.id)
            data["muted"].setdefault(ck_mute, {})
            data["muted"][ck_mute][uk_mute] = {
                "duration": f"{minutes} دقیقه" if minutes else "دائمی",
                "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
            }
            save_data()

            duration_text = f"{minutes} دقیقه" if minutes else "دائمی"

            answer = (
                f"دوره‌ی نقاهتِ زبونت به مدت {duration_text} شروع شد 🤫\n\n"
                f"👤 کاربر: {target.mention_html()}\n"
                f"🆔 آیدی: <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unmute":
            await context.bot.restrict_chat_member(
                chat.id,
                target.id,
                permissions=ChatPermissions(
                    can_send_messages=True, can_send_audios=True, can_send_documents=True,
                    can_send_photos=True, can_send_videos=True, can_send_video_notes=True,
                    can_send_voice_notes=True, can_send_polls=True, can_send_other_messages=True,
                    can_add_web_page_previews=True,
                ),
                use_independent_chat_permissions=True,
            )

            ck_mute = chat_key(chat.id)
            uk_mute = user_key(target.id)
            if ck_mute in data["muted"] and uk_mute in data["muted"][ck_mute]:
                del data["muted"][ck_mute][uk_mute]
                if not data["muted"][ck_mute]:
                    del data["muted"][ck_mute]
                save_data()

            answer = (
                f"سکوتش به پایان رسید، خدا به دادمون برسه 🤯\n\n"
                f"👤 کاربر: {target.mention_html()}\n"
                f"🆔 آیدی: <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "warn":
            try:
                target_member = await context.bot.get_chat_member(chat.id, target.id)
                if target_member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ نمی‌تونی به ادمین زهر بدی!")
                    return
            except TelegramError:
                pass

            ck = chat_key(chat.id)
            uk = user_key(target.id)
            data["warns"].setdefault(ck, {})
            current = int(data["warns"][ck].get(uk, 0))
            new_count = current + 1

            if new_count == 1:
                data["warns"][ck][uk] = 1
                answer = "زهر اول: اولین قطره‌ی زهر وارد پرونده شد؛ دفعه‌ی بعد، عواقبش با خودته. 🥀"
            elif new_count == 2:
                data["warns"][ck][uk] = 2
                answer = "🦂 زهر دوم: زهر دوم هم ثبت شد؛ فقط یک قدم تا حذف از این قلمرو فاصله داری. ☠️"
            else:
                try:
                    await context.bot.ban_chat_member(chat.id, target.id)
                    data["warns"][ck][uk] = 0
                    answer = "🦂 زهر سوم: سه قطره زهر، یک حکم قطعی! ⚖️\n🚫 مهلتت تموم شد؛ از این قلمرو اخراج شدی."
                    data["banned"].setdefault(ck, {})
                    data["banned"][ck][uk] = {
                        "reason": "زهر سوم (دستی)",
                        "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
                    }
                except TelegramError as e:
                    logger.exception(f"خطا در بن: {e}")
                    answer = "❌ خطا در اجرای حکم."

            save_data()

            final_count = int(data["warns"].get(ck, {}).get(uk, 0))
            warn_display = f"⚠️ اخطار: {final_count} از ۳\n" if final_count > 0 else ""

            text = (
                f"{answer}\n\n"
                f"{warn_display}"
                f"👤 کاربر: {target.mention_html()}\n"
                f"🆔 آیدی: <code>{target.id}</code>"
            )
            await message.reply_text(text, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unwarn":
            ck, uk = chat_key(chat.id), user_key(target.id)
            current = int(data["warns"].get(ck, {}).get(uk, 0))

            if current > 0:
                data["warns"][ck][uk] = 0
                save_data()
                answer = (
                    f"🧪 پادزهر اجرا شد؛ اخطارهای {target.mention_html()} پاک شد.\n"
                    f"⚠️ تعداد اخطارهای قبلی: {current}\n\n"
                    f"👤 کاربر: {target.mention_html()}\n"
                    f"🆔 آیدی: <code>{target.id}</code>"
                )
            else:
                answer = (
                    f"❌ {target.mention_html()} هیچ اخطاری نداره که پادزهر بخواد.\n\n"
                    f"👤 کاربر: {target.mention_html()}\n"
                    f"🆔 آیدی: <code>{target.id}</code>"
                )

            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "special":
            ck, uk = chat_key(chat.id), user_key(target.id)
            data["special"].setdefault(ck, [])
            if uk not in data["special"][ck]:
                data["special"][ck].append(uk)

            await context.bot.restrict_chat_member(
                chat.id,
                target.id,
                permissions=ChatPermissions(
                    can_send_messages=True, can_send_audios=False, can_send_documents=False,
                    can_send_photos=False, can_send_videos=False, can_send_video_notes=False,
                    can_send_voice_notes=False, can_send_polls=False, can_send_other_messages=False,
                    can_add_web_page_previews=False,
                ),
                use_independent_chat_permissions=True,
            )
            save_data()
            answer = (
                f"💎 {target.mention_html()} به عضو ویژه تبدیل شد؛ ارسال رسانه برای او محدود شد.\n\n"
                f"👤 کاربر: {target.mention_html()}\n"
                f"🆔 آیدی: <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
