async def tag_all(update, context):
    if not await require_admin(update, context):
        return

    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return

    text = message.text or ""
    custom_text = "📢 توجه!"
    if text.startswith("/tagall"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1:
            custom_text = parts[1].strip()
    elif text.startswith("تگ"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1 and parts[1].strip():
            custom_text = parts[1].strip()

    reply_text = ""
    if message.reply_to_message:
        replied = message.reply_to_message
        if replied.text:
            reply_text = f"\n\n💬 **پیام ریپلای‌شده:**\n{replied.text[:200]}"
        elif replied.caption:
            reply_text = f"\n\n💬 **کپشن ریپلای‌شده:**\n{replied.caption[:200]}"

    ck = chat_key(chat.id)

    try:
        admins = await context.bot.get_chat_administrators(chat.id)
        admin_ids = {a.user.id for a in admins}
    except TelegramError:
        admin_ids = set()

    user_ids_to_tag = set(admin_ids)

    for source in ("message_counts", "join_dates"):
        for key in data.get(source, {}).keys():
            if key.startswith(f"{ck}:"):
                try:
                    user_ids_to_tag.add(int(key.split(":", 1)[1]))
                except (ValueError, IndexError):
                    pass

    for source in ("warns", "muted", "banned"):
        for uk in data.get(source, {}).get(ck, {}).keys():
            try:
                user_ids_to_tag.add(int(uk))
            except (ValueError, TypeError):
                pass

    for key in data.get("identities", {}).keys():
        if key.startswith(f"{ck}:"):
            try:
                user_ids_to_tag.add(int(key.split(":", 1)[1]))
            except (ValueError, IndexError):
                pass

    for uk in data.get("special", {}).get(ck, []):
        try:
            user_ids_to_tag.add(int(uk))
        except (ValueError, TypeError):
            pass

    user_ids_to_tag.discard(context.bot.id)

    if not user_ids_to_tag:
        await reply_and_delete(update, "⚠️ هیچ عضوی برای تگ کردن پیدا نشد!")
        return

    mentions = []
    count = 0
    MAX_PER_MESSAGE = 50
    seen_ids = set()

    for uid in user_ids_to_tag:
        if uid in seen_ids:
            continue
        seen_ids.add(uid)
        try:
            member = await context.bot.get_chat_member(chat.id, uid)
            if member.user.is_bot:
                continue
            if member.status == ChatMemberStatus.LEFT:
                continue
            if member.status == ChatMemberStatus.RESTRICTED and not getattr(member, "is_member", False):
                continue
            name = member.user.first_name or "کاربر"
            safe_name = name.replace("[", "").replace("]", "").replace("(", "").replace(")", "")
            mentions.append(f"[{safe_name}](tg://user?id={uid})")
            count += 1
        except TelegramError:
            continue

        if len(mentions) >= MAX_PER_MESSAGE:
            try:
                await context.bot.send_message(
                    chat_id=chat.id,
                    text=f"{custom_text}{reply_text}\n\n" + " ".join(mentions),
                    parse_mode="Markdown",
                    disable_web_page_preview=True,
                )
            except TelegramError as e:
                logger.exception(f"خطا در ارسال تگ: {e}")
            mentions = []

    if mentions:
        try:
            await context.bot.send_message(
                chat_id=chat.id,
