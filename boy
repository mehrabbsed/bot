XP_PER_MESSAGE = 5
LEVEL_UP_BASE = 100


def get_user_xp(chat_id, user_id):
    return int(data.get("xp", {}).get(chat_key(chat_id), {}).get(user_key(user_id), 0))


def set_user_xp(chat_id, user_id, xp):
    data.setdefault("xp", {}).setdefault(chat_key(chat_id), {})[user_key(user_id)] = xp


def xp_to_level(xp):
    level = 0
    need = LEVEL_UP_BASE
    while xp >= need:
        xp -= need
        level += 1
        need = LEVEL_UP_BASE * (level + 1)
    return level, xp, need


