            new_img.paste(img, offset, img)
            out = io.BytesIO()
            new_img.save(out, format="WEBP")
            out.seek(0)
            return out
        sticker_buf = await asyncio.to_thread(_process)
        await message.reply_sticker(sticker=sticker_buf)
        await status.delete()
