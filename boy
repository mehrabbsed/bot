@admin_only
async def member_action(update, context, action):
    chat = update.effective_chat
    message = update.effective_message
    if action == "profile" and message and message.text == "👤 پروفایل من":
        target = update.effective_user
    else:
        target = await get_target(update)
    if not target:
        return
    if target.id == context.bot.id:
        await reply_and_delete(update, "😅 روی خودم اجرا نمی‌کنم.")
        return
    if target.id == update.effective_user.id and action != "profile":
        await reply_and_delete(update, "⚠️ روی خودت اجرا نکن.")
        return
    try:
        if action in ("kick", "ban"):
            try:
                tm = await context.bot.get_chat_member(chat.id, target.id)
                if tm.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ ادمین!")
                    return
            except TelegramError:
                pass
            await context.bot.ban_chat_member(chat.id, target.id)
            bump_daily_stat(chat.id, "leaves")
            if action == "ban":
                ck_b = chat_key(chat.id)
                uk_b = user_key(target.id)
                data["banned"].setdefault(ck_b, {})
                data["banned"][ck_b][uk_b] = {
                    "reason": "بن دستی",
                    "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
                }
                save_data()
            if action == "kick":
                await context.bot.unban_chat_member(chat.id, target.id, only_if_banned=True)
                answer = (
                    "متهم فکر کرد شخصیت اصلی داستانه.\n\n"
                    f"👤 {target.mention_html()}\n🆔 <code>{target.id}</code>"
                )
            else:
                answer = f"🚫 {target.mention_html()} بن شد.\n\n🆔 <code>{target.id}</code>"
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unban":
            await context.bot.unban_chat_member(chat.id, target.id, only_if_banned=True)
            ck_b = chat_key(chat.id)
            uk_b = user_key(target.id)
            if ck_b in data["banned"] and uk_b in data["banned"][ck_b]:
                del data["banned"][ck_b][uk_b]
                if not data["banned"][ck_b]:
                    del data["banned"][ck_b]
                save_data()
            answer = (
                "جهنم هم دیگه ظرفیتت رو نداشت. برگرد. 🥀\n\n"
                f"👤 {target.mention_html()}\n🆔 <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "mute":
            try:
                tm = await context.bot.get_chat_member(chat.id, target.id)
                if tm.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ ادمین!")
                    return
            except TelegramError:
                pass
            minutes = 0
            raw_minutes = context.args[0] if context.args else context.user_data.get("plain_mute_minutes")
            if raw_minutes is not None:
                try:
                    minutes = int(raw_minutes)
                except (ValueError, TypeError):
                    await reply_and_delete(update, "❌ عدد: درتوبزار 5")
                    return
                if not 1 <= minutes <= 10080:
                    await reply_and_delete(update, "⚠️ ۱-۱۰۰۸۰ دقیقه.")
                    return
            until = datetime.now(timezone.utc) + timedelta(minutes=minutes) if minutes else None
            await context.bot.restrict_chat_member(
                chat.id, target.id,
                permissions=ChatPermissions(can_send_messages=False),
                until_date=until,
                use_independent_chat_permissions=True,
            )
            ck_m = chat_key(chat.id)
            uk_m = user_key(target.id)
            data["muted"].setdefault(ck_m, {})
            data["muted"][ck_m][uk_m] = {
                "duration": f"{minutes} دقیقه" if minutes else "دائمی",
                "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
            }
            save_data()
            dur = f"{minutes} دقیقه" if minutes else "دائمی"
            answer = (
                f"دوره‌ی نقاهت {dur} شروع شد 🤫\n\n"
                f"👤 {target.mention_html()}\n🆔 <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unmute":
            await context.bot.restrict_chat_member(
                chat.id, target.id,
                permissions=ChatPermissions(
                    can_send_messages=True, can_send_audios=True, can_send_documents=True,
                    can_send_photos=True, can_send_videos=True, can_send_video_notes=True,
                    can_send_voice_notes=True, can_send_polls=True, can_send_other_messages=True,
                    can_add_web_page_previews=True,
                ),
                use_independent_chat_permissions=True,
            )
            ck_m = chat_key(chat.id)
            uk_m = user_key(target.id)
            if ck_m in data["muted"] and uk_m in data["muted"][ck_m]:
                del data["muted"][ck_m][uk_m]
                if not data["muted"][ck_m]:
                    del data["muted"][ck_m]
                save_data()
            answer = (
                f"سکوتش تموم شد 🤯\n\n"
                f"👤 {target.mention_html()}\n🆔 <code>{target.id}</code>"
            )
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "warn":
            try:
                tm = await context.bot.get_chat_member(chat.id, target.id)
                if tm.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
                    await reply_and_delete(update, "⚠️ ادمین!")
                    return
            except TelegramError:
                pass
            ck = chat_key(chat.id)
            uk = user_key(target.id)
            data["warns"].setdefault(ck, {})
            current = int(data["warns"][ck].get(uk, 0))
            new_count = current + 1
            if new_count == 1:
                data["warns"][ck][uk] = 1
                bump_daily_stat(chat.id, "warns")
                answer = "زهر اول: اولین قطره وارد پرونده شد. 🥀"
            elif new_count == 2:
                data["warns"][ck][uk] = 2
                bump_daily_stat(chat.id, "warns")
                answer = "🦂 زهر دوم: یک قدم تا حذف. ☠️"
            else:
                try:
                    await context.bot.ban_chat_member(chat.id, target.id)
                    data["warns"][ck][uk] = 0
                    bump_daily_stat(chat.id, "leaves")
                    answer = "🦂 زهر سوم: اخراج شدی! ⚖️"
                    data["banned"].setdefault(ck, {})
                    data["banned"][ck][uk] = {
                        "reason": "زهر سوم",
                        "date": datetime.now().strftime("%Y/%m/%d %H:%M"),
                    }
                except TelegramError as e:
                    logger.exception(f"{e}")
                    answer = "❌ خطا."
            save_data()
            final_count = int(data["warns"].get(ck, {}).get(uk, 0))
            wd = f"⚠️ اخطار: {final_count} از ۳\n" if final_count > 0 else ""
            text = f"{answer}\n\n{wd}👤 {target.mention_html()}\n🆔 <code>{target.id}</code>"
            await message.reply_text(text, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "unwarn":
            ck, uk = chat_key(chat.id), user_key(target.id)
            current = int(data["warns"].get(ck, {}).get(uk, 0))
            if current > 0:
                data["warns"][ck][uk] = 0
                save_data()
                answer = (
                    f"🧪 پادزهر؛ {target.mention_html()} پاک شد.\n"
                    f"⚠️ قبلی: {current}\n🆔 <code>{target.id}</code>"
                )
            else:
                answer = f"❌ {target.mention_html()} اخطاری نداره.\n\n🆔 <code>{target.id}</code>"
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "special":
            ck, uk = chat_key(chat.id), user_key(target.id)
            data["special"].setdefault(ck, [])
            if uk not in data["special"][ck]:
                data["special"][ck].append(uk)
            await context.bot.restrict_chat_member(
                chat.id, target.id,
                permissions=ChatPermissions(
                    can_send_messages=True, can_send_audios=False,
                    can_send_documents=False, can_send_photos=False,
                    can_send_videos=False, can_send_video_notes=False,
                    can_send_voice_notes=False, can_send_polls=False,
                    can_send_other_messages=False, can_add_web_page_previews=False,
                ),
                use_independent_chat_permissions=True,
            )
            save_data()
            answer = f"💎 {target.mention_html()} عضو ویژه شد.\n\n🆔 <code>{target.id}</code>"
            await message.reply_text(answer, parse_mode="HTML")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

        elif action == "profile":
            ck = chat_key(chat.id)
            uk = user_key(target.id)
            msg_key = f"{ck}:{uk}"
            ident = data.get("identities", {}).get(identity_key(chat.id, target.id), "ثبت نشده")
            warns_raw = data.get("warns", {}).get(ck, {}).get(uk, 0)
            try:
                warns = int(warns_raw)
            except (ValueError, TypeError):
                warns = 0
            msg_raw = data.get("message_counts", {}).get(msg_key, 0)
            try:
                msg_count = int(msg_raw)
            except (ValueError, TypeError):
                msg_count = 0
            join_date = data.get("join_dates", {}).get(msg_key, "نامشخص")
            if join_date == "نامشخص":
                try:
                    m = await context.bot.get_chat_member(chat.id, target.id)
                    if m.joined_date:
                        jd = jdatetime.datetime.fromgregorian(datetime=m.joined_date)
                        join_date = jd.strftime("%Y/%m/%d")
                except Exception:
                    pass
            xp = get_user_xp(chat.id, target.id)
            level, _, _ = xp_to_level(xp)
            answer = (
                f"👤 **پروفایل {target.first_name}**\n\n"
                f"🆔 `{target.id}`\n"
                f"📝 @{target.username if target.username else 'ندارد'}\n"
                f"📅 عضویت: {join_date}\n"
                f"💬 پیام‌ها: {msg_count}\n"
                f"🏅 سطح: {level} ({xp} XP)\n"
                f"⚠️ اخطارها: {warns} از ۳\n"
                f"🔖 هویت: {ident}"
            )
            await message.reply_text(answer, parse_mode="Markdown")
            try:
                await message.delete()
            except TelegramError:
                pass
            return

    except TelegramError as exc:
        logger.exception(f"{exc}")
        await reply_and_delete(update, f"❌ {exc}")


