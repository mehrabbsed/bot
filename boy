async def tag_active(update, context):
    if not await require_admin(update, context):
        return
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    ck = chat_key(chat.id)
    active_users = []
    for key, count in data.get("message_counts", {}).items():
        if key.startswith(f"{ck}:"):
            try:
                active_users.append((int(key.split(":")[1]), count))
            except (ValueError, IndexError):
                pass
    active_users.sort(key=lambda x: x[1], reverse=True)
    active_users = active_users[:20]
    if not active_users:
        await reply_and_delete(update, "⚠️ هیچ کاربر فعالی پیدا نشد!")
        return

    mentions = []
    for uid, _ in active_users:
        try:
            m = await context.bot.get_chat_member(chat.id, uid)
            if not m.user.is_bot:
                mentions.append(f"[{m.user.first_name}](tg://user?id={uid})")
