def is_allowed_chat(chat_id) -> bool:
    return chat_id in ALLOWED_CHATS


def _is_creator_question(text: str) -> bool:
    t = text.casefold().strip()
    return any(re.search(p, t, re.IGNORECASE) for p in CREATOR_PATTERNS)


