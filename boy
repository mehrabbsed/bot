async def check_filter(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(chat.id):
        return
    if user.is_bot:
        return

    text_content = message.text or message.caption
    if not text_content:
        return

    if text_content.startswith(("/anon", "ناشناس", "پیام مخفی", "/", "تگ", "فیلتر", "حذف فیلتر", "فیلترها")):
        return

    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        pass

    chat_id = str(chat.id)
    filters = data["filters"].get(chat_id, [])
    if not filters:
        return

    text_lower = text_content.casefold()
    for word in filters:
        if not word:
            continue
        pattern = r'(?<![^\W\d_])' + re.escape(word) + r'(?![^\W\d_])'
        if re.search(pattern, text_lower, re.IGNORECASE | re.UNICODE):
            await notify_delete(context, chat, user, message, f"کلمه فیلترشده: «{word}»")
            try:
                await message.delete()
            except TelegramError:
                pass
            return


