async def tag_all(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not await require_admin(update, context):
        return

    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return

    text = message.text or ""

    custom_text = "📢 توجه!"
    if text.startswith("/tagall"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1:
            custom_text = parts[1].strip()
    elif text.startswith("تگ"):
        parts = text.split(maxsplit=1)
        if len(parts) > 1:
            rest = parts[1].strip()
            if rest:
                custom_text = rest

    reply_text = ""
    if message.reply_to_message:
        replied = message.reply_to_message
        if replied.text:
            reply_text = f"\n\n💬 **پیام ریپلای‌شده:**\n{replied.text[:200]}"
        elif replied.caption:
            reply_text = f"\n\n💬 **کپشن ریپلای‌شده:**\n{replied.caption[:200]}"

    try:
        admins = await context.bot.get_chat_administrators(chat.id)
        admin_ids = {a.user.id for a in admins}
    except TelegramError:
        admin_ids = set()

    mentions = []
    count = 0
    MAX_PER_MESSAGE = 50

    try:
        user_ids_to_tag = set(admin_ids)
        for key in data.get("message_counts", {}).keys():
            if key.startswith(f"{chat_key(chat.id)}:"):
                try:
                    uid = int(key.split(":")[1])
                    user_ids_to_tag.add(uid)
                except (ValueError, IndexError):
                    pass

        for key in data.get("join_dates", {}).keys():
            if key.startswith(f"{chat_key(chat.id)}:"):
                try:
                    uid = int(key.split(":")[1])
                    user_ids_to_tag.add(uid)
                except (ValueError, IndexError):
                    pass

        user_ids_to_tag.discard(context.bot.id)

        if not user_ids_to_tag:
            await reply_and_delete(update, "⚠️ هیچ عضوی برای تگ کردن پیدا نشد!")
            return

        for uid in user_ids_to_tag:
            try:
                member = await context.bot.get_chat_member(chat.id, uid)
                if member.user.is_bot:
                    continue
                if member.status == ChatMemberStatus.LEFT:
                    continue
                if member.status == ChatMemberStatus.RESTRICTED and not getattr(member, "is_member", False):
                    continue
                mentions.append(f"[{member.user.first_name}](tg://user?id={uid})")
                count += 1
            except TelegramError:
                continue

            if len(mentions) >= MAX_PER_MESSAGE:
                text_to_send = f"{custom_text}{reply_text}\n\n" + " ".join(mentions)
                try:
                    await context.bot.send_message(
                        chat_id=chat.id,
                        text=text_to_send,
                        parse_mode="Markdown",
                    )
                except TelegramError as e:
                    logger.exception(f"خطا در ارسال تگ: {e}")
                mentions = []

        if mentions:
            text_to_send = f"{custom_text}{reply_text}\n\n" + " ".join(mentions)
            try:
                await context.bot.send_message(
                    chat_id=chat.id,
                    text=text_to_send,
                    parse_mode="Markdown",
                )
            except TelegramError as e:
                logger.exception(f"خطا در ارسال تگ: {e}")

        try:
            await message.delete()
        except TelegramError:
            pass

        logger.info(f"✅ تگ {count} نفر انجام شد")

    except TelegramError as e:
        logger.exception(f"خطا در تگ: {e}")
        await reply_and_delete(update, f"❌ خطا در تگ کردن: {e}")


async def tag_admins(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not await require_admin(update, context):
        return

    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return

    try:
        admins = await context.bot.get_chat_administrators(chat.id)
    except TelegramError as e:
        await reply_and_delete(update, f"❌ خطا در گرفتن ادمین‌ها: {e}")
        return

    mentions = []
    for admin in admins:
        if admin.user.is_bot:
            continue
        mentions.append(f"[{admin.user.first_name}](tg://user?id={admin.user.id})")

    if not mentions:
        await reply_and_delete(update, "⚠️ هیچ ادمینی پیدا نشد!")
        return

    text = "👑 **ادمین‌های گروه:**\n\n" + " ".join(mentions)

    try:
        await context.bot.send_message(
            chat_id=chat.id,
            text=text,
            parse_mode="Markdown",
        )
    except TelegramError as e:
        logger.exception(f"خطا در تگ ادمین‌ها: {e}")

    try:
        await message.delete()
    except TelegramError:
        pass


async def tag_active(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not await require_admin(update, context):
        return

    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return

    ck = chat_key(chat.id)

    active_users = []
    for key, count in data.get("message_counts", {}).items():
        if key.startswith(f"{ck}:"):
            try:
                uid = int(key.split(":")[1])
                active_users.append((uid, count))
            except (ValueError, IndexError):
                pass

    active_users.sort(key=lambda x: x[1], reverse=True)
    active_users = active_users[:20]

    if not active_users:
        await reply_and_delete(update, "⚠️ هیچ کاربر فعالی پیدا نشد!")
        return

    mentions = []
    for uid, _ in active_users:
        try:
            member = await context.bot.get_chat_member(chat.id, uid)
            if member.user.is_bot:
                continue
            mentions.append(f"[{member.user.first_name}](tg://user?id={uid})")
        except TelegramError:
            continue

    if not mentions:
        await reply_and_delete(update, "⚠️ هیچ کاربر فعالی پیدا نشد!")
        return

    text = "🔥 **۲۰ کاربر فعال اخیر:**\n\n" + " ".join(mentions)

    try:
        await context.bot.send_message(
            chat_id=chat.id,
            text=text,
            parse_mode="Markdown",
        )
    except TelegramError as e:
        logger.exception(f"خطا در تگ: {e}")

    try:
        await message.delete()
    except TelegramError:
        pass


