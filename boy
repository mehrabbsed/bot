@admin_only
async def anon_command(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("⚠️ فقط در گروه.")
        return
    text = message.text or ""
    anon_text = None
    if text.startswith("/anon"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2:
            await reply_and_delete(update, "⚠️ `/anon متن`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("ناشناس"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2:
            await reply_and_delete(update, "⚠️ `ناشناس متن`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("پیام مخفی"):
        parts = text.split(maxsplit=2)
        if len(parts) < 3:
            await reply_and_delete(update, "⚠️ `پیام مخفی متن`")
            return
        anon_text = parts[2].strip()
    else:
        return
    if not anon_text or len(anon_text) > 4000:
        await reply_and_delete(update, "⚠️ نامعتبر")
        return
    reply_to = message.reply_to_message.message_id if message.reply_to_message else None
    group_text = f"🕵️ **ناشناس**\n\n{anon_text}"
    admin_text = (
        f"🕵️ **پیام ناشناس**\n\n"
        f"👥 {chat.title}\n🆔 <code>{chat.id}</code>\n\n"
        f"👤 {user.mention_html()}\n🆔 <code>{user.id}</code>\n"
        f"📝 @{user.username if user.username else 'ندارد'}\n\n"
        f"💬 {anon_text}"
    )
    admin_ids = await get_cached_admin_ids(chat.id, context)
    targets = [u for u in admin_ids if u != user.id and u != MY_USER_ID]
    bg = []
    async def del_msg():
        try:
            await message.delete()
        except TelegramError:
            pass
    bg.append(asyncio.create_task(del_msg()))
    if MY_USER_ID and MY_USER_ID != user.id:
        bg.append(asyncio.create_task(context.bot.send_message(
            chat_id=MY_USER_ID, text="🔔 **کپی**\n\n" + admin_text, parse_mode="HTML",
        )))
    for tid in targets:
        bg.append(asyncio.create_task(context.bot.send_message(
            chat_id=tid, text=admin_text, parse_mode="HTML",
        )))
    try:
        if reply_to:
            await context.bot.send_message(
                chat_id=chat.id, text=group_text, parse_mode="Markdown",
                reply_to_message_id=reply_to,
            )
        else:
            await context.bot.send_message(chat_id=chat.id, text=group_text, parse_mode="Markdown")
    except TelegramError as e:
        logger.exception(f"{e}")
    if bg:
        await asyncio.gather(*bg, return_exceptions=True)
    try:
        with open("anon_logs.txt", "a", encoding="utf-8") as f:
            f.write(f"{datetime.now()} | {chat.id} | {user.id} | {anon_text[:50]}\n")
    except OSError:
        pass


