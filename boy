async def count_messages(update, context):
    if not update.effective_chat or not update.effective_user:
        return
    if update.effective_chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not is_allowed_chat(update.effective_chat.id):
        return
    user = update.effective_user
    if user.is_bot:
        return

    ck = chat_key(update.effective_chat.id)
    uk = user_key(user.id)
    key = f"{ck}:{uk}"
    msg = update.effective_message

    if not isinstance(data.get("message_counts"), dict):
        data["message_counts"] = {}
    try:
        current = int(data["message_counts"].get(key, 0))
    except (ValueError, TypeError):
        current = 0
    data["message_counts"][key] = current + 1

    now = datetime.now()
    date_str = now.strftime("%Y-%m-%d")
    data.setdefault("daily_stats", {})
    data["daily_stats"].setdefault(ck, {})
    data["daily_stats"][ck].setdefault(date_str, {
        "messages": 0, "joins": 0, "leaves": 0, "warns": 0,
        "photos": 0, "videos": 0, "voices": 0, "hourly": [0] * 24,
    })
    stats = data["daily_stats"][ck][date_str]
    stats["messages"] += 1
    stats["hourly"][now.hour] += 1

    if msg:
        if msg.photo:
            stats["photos"] += 1
        elif msg.video:
            stats["videos"] += 1
        elif msg.voice:
            stats["voices"] += 1

    if msg:
        msg_text = msg.text or msg.caption or ""
        if msg_text:
            if not isinstance(data.get("word_stats"), dict):
                data["word_stats"] = {}
            data["word_stats"].setdefault(ck, {})
            words = re.findall(r"[\w\u0600-\u06FF]{3,}", msg_text.casefold())
            for w in words[:20]:
                data["word_stats"][ck][w] = data["word_stats"][ck].get(w, 0) + 1

    if msg:
        msg_text = msg.text or msg.caption or ""
        if msg_text:
            ck_str = cache_key(ck, msg.message_id)
            data["message_cache"][ck_str] = msg_text

    save_data()


