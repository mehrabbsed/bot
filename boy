# پیام ناشناس
# ==========================================
async def anon_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user:
        return

    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("⚠️ این دستور فقط در گروه کار می‌کنه.")
        return

    text = message.text or ""
    anon_text = None

    if text.startswith("/anon"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2 or not parts[1].strip():
            await reply_and_delete(update, "⚠️ استفاده: `/anon متن پیام`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("ناشناس"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2 or not parts[1].strip():
            await reply_and_delete(update, "⚠️ استفاده: `ناشناس متن پیام`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("پیام مخفی"):
        parts = text.split(maxsplit=2)
        if len(parts) < 3 or not parts[2].strip():
            await reply_and_delete(update, "⚠️ استفاده: `پیام مخفی متن پیام`")
            return
        anon_text = parts[2].strip()
    else:
        return

    if not anon_text:
        await reply_and_delete(update, "⚠️ متن پیام خالیه!")
        return

    if len(anon_text) > 4000:
        await reply_and_delete(update, "⚠️ متن خیلی طولانیه (حداکثر ۴۰۰۰ کاراکتر).")
        return

    # ========================================
    # ۱. ارسال به گروه (ناشناس برای همه)
    # ========================================
    group_text = f"🕵️ **کاربر ناشناس**\n\n{anon_text}"

    try:
        if message.reply_to_message:
            await context.bot.send_message(
                chat_id=chat.id,
                text=group_text,
                parse_mode="Markdown",
                reply_to_message_id=message.reply_to_message.message_id,
            )
        else:
            await context.bot.send_message(
                chat_id=chat.id,
                text=group_text,
                parse_mode="Markdown",
            )
    except TelegramError as e:
        logger.exception(f"خطا در ارسال پیام ناشناس به گروه: {e}")
        await reply_and_delete(update, f"❌ خطا در ارسال: {e}")
        return

    # ========================================
    # ۲. ارسال به PV هر ادمین (با اسم واقعی)
    # ========================================
    try:
        admins = await context.bot.get_chat_administrators(chat.id)
    except TelegramError:
        admins = []

    admin_text = (
        f"🕵️ **پیام ناشناس جدید**\n\n"
        f"👥 گروه: {chat.title}\n"
        f"👤 فرستنده: {user.mention_html()}\n"
        f"🆔 آیدی: <code>{user.id}</code>\n"
        f"📝 نام کاربری: @{user.username if user.username else 'ندارد'}\n\n"
        f"💬 **متن پیام:**\n{anon_text}"
    )

    sent_to_admins = 0
    for admin in admins:
        if admin.user.is_bot:
            continue
        if admin.user.id == user.id:
            continue

        try:
            await context.bot.send_message(
                chat_id=admin.user.id,
                text=admin_text,
                parse_mode="HTML",
            )
            sent_to_admins += 1
        except TelegramError:
            continue

    # ========================================
    # ۳. لاگ مخفی
    # ========================================
    try:
        with open("anon_logs.txt", "a", encoding="utf-8") as f:
            f.write(
                f"{datetime.now()} | chat={chat.id} | "
                f"user={user.id} | name={user.first_name} | "
                f"text={anon_text[:50]}\n"
            )
    except OSError:
        pass

    # ========================================
    # ۴. حذف دستور کاربر
    # ========================================
    try:
        await message.delete()
    except TelegramError:
        pass

    logger.info(f"✅ پیام ناشناس ارسال شد | به {sent_to_admins} ادمین")


