async def anon_command(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("⚠️ این دستور فقط در گروه کار می‌کنه.")
        return

    text = message.text or ""
    anon_text = None

    if text.startswith("/anon"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2 or not parts[1].strip():
            await reply_and_delete(update, "⚠️ استفاده: `/anon متن پیام`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("ناشناس"):
        parts = text.split(maxsplit=1)
        if len(parts) < 2 or not parts[1].strip():
            await reply_and_delete(update, "⚠️ استفاده: `ناشناس متن پیام`")
            return
        anon_text = parts[1].strip()
    elif text.startswith("پیام مخفی"):
        parts = text.split(maxsplit=2)
        if len(parts) < 3 or not parts[2].strip():
            await reply_and_delete(update, "⚠️ استفاده: `پیام مخفی متن پیام`")
            return
        anon_text = parts[2].strip()
    else:
        return

    if not anon_text or len(anon_text) > 4000:
        await reply_and_delete(update, "⚠️ متن خالیه یا خیلی طولانیه.")
        return

    reply_to_msg_id = None
    if message.reply_to_message:
        reply_to_msg_id = message.reply_to_message.message_id

    group_text = f"🕵️ **کاربر ناشناس**\n\n{anon_text}"
    admin_text = (
        f"🕵️ **پیام ناشناس جدید**\n\n"
        f"👥 **گروه:** {chat.title}\n"
        f"🆔 **آیدی گروه:** <code>{chat.id}</code>\n\n"
        f"👤 **فرستنده اصلی:** {user.mention_html()}\n"
        f"🆔 **آیدی:** <code>{user.id}</code>\n"
        f"📝 **یوزرنیم:** @{user.username if user.username else 'ندارد'}\n\n"
        f"💬 **متن پیام:**\n{anon_text}"
    )

    admin_ids = await get_cached_admin_ids(chat.id, context)
    targets = [uid for uid in admin_ids if uid != user.id and uid != MY_USER_ID]

    bg_tasks = []

    async def delete_user_msg():
        try:
            await message.delete()
        except TelegramError:
            pass
    bg_tasks.append(asyncio.create_task(delete_user_msg()))

    if MY_USER_ID and MY_USER_ID != user.id:
        bg_tasks.append(asyncio.create_task(
            context.bot.send_message(
                chat_id=MY_USER_ID,
                text="🔔 **[کپی شخصی]**\n\n" + admin_text,
                parse_mode="HTML",
            )
        ))

    for tid in targets:
        bg_tasks.append(asyncio.create_task(
            context.bot.send_message(chat_id=tid, text=admin_text, parse_mode="HTML")
        ))

    try:
        if reply_to_msg_id:
            await context.bot.send_message(
                chat_id=chat.id, text=group_text, parse_mode="Markdown",
                reply_to_message_id=reply_to_msg_id,
            )
        else:
            await context.bot.send_message(chat_id=chat.id, text=group_text, parse_mode="Markdown")
    except TelegramError as e:
        logger.exception(f"خطا در ارسال پیام ناشناس: {e}")

    if bg_tasks:
        await asyncio.gather(*bg_tasks, return_exceptions=True)

    try:
        with open("anon_logs.txt", "a", encoding="utf-8") as f:
            f.write(f"{datetime.now()} | chat={chat.id} | user={user.id} | text={anon_text[:50]}\n")
    except OSError:
        pass


