                f"🆔 <code>{target.id}</code>\n"
                f"💎 XP: <b>{old_xp}</b> → <b>{new_xp}</b> ({sign}{amount})\n"
                f"📊 سطح: <b>{new_level}</b>{level_change}",
                parse_mode="HTML",
            )
            return

    target = user
    if message.reply_to_message and message.reply_to_message.from_user:
        target = message.reply_to_message.from_user
        if target.is_bot:
            await reply_and_delete(update, "⚠️ ربات‌ها XP ندارن.")
