async def status_text(chat_id, context):
    locks = get_locks(chat_id)
    filters_count = len(data["filters"].get(str(chat_id), []))
    warns_count = 0
    for key, warns in data["warns"].items():
        if key == str(chat_id):
            warns_count += sum(1 for w in warns.values() if w > 0)
    enabled_locks = [name for name, enabled in locks.items() if enabled]

    return (
        "📊 وضعیت گروه\n\n"
        f"🔒 قفل‌های فعال: {', '.join(enabled_locks) if enabled_locks else 'هیچ‌کدام'}\n"
        f"🚫 تعداد فیلترها: {filters_count}\n"
        f"⚠️ مجموع اخطارها: {warns_count}"
    )


async def status_command(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    text = await status_text(chat.id, context)
    await message.reply_text(text)


