async def save_identity_smart(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return

    if not message.reply_to_message:
        await message.reply_text("⚠️ باید روی پیامی که حاوی هویت هست ریپلای کنی و بنویسی: ثبت هویت")
        return

    target = message.reply_to_message.from_user
    replied = message.reply_to_message

    identity_value = None
    kind_label = ""

    # ۱. عکس (با یا بدون کپشن) → file_id + کپشن
    if replied.photo:
        file_id = replied.photo[-1].file_id
        caption = (replied.caption or "").strip()
        identity_value = f"PHOTO:{file_id}|CAPTION|{caption}" if caption else f"PHOTO:{file_id}"
        kind_label = "🖼 عکس" + (" + 💬 کپشن" if caption else "")

    # ۲. ویدیو
    elif replied.video:
        file_id = replied.video.file_id
        caption = (replied.caption or "").strip()
        identity_value = f"VIDEO:{file_id}|CAPTION|{caption}" if caption else f"VIDEO:{file_id}"
        kind_label = "🎬 ویدیو" + (" + 💬 کپشن" if caption else "")

    # ۳. ویدیونوت
    elif replied.video_note:
        identity_value = f"VIDEO_NOTE:{replied.video_note.file_id}"
        kind_label = "🎥 ویدیونوت"

    # ۴. ویس
    elif replied.voice:
        file_id = replied.voice.file_id
        caption = (replied.caption or "").strip()
        identity_value = f"VOICE:{file_id}|CAPTION|{caption}" if caption else f"VOICE:{file_id}"
        kind_label = "🎤 ویس" + (" + 💬 کپشن" if caption else "")

    # ۵. فایل/سند
    elif replied.document:
        file_id = replied.document.file_id
        caption = (replied.caption or "").strip()
        identity_value = f"DOCUMENT:{file_id}|CAPTION|{caption}" if caption else f"DOCUMENT:{file_id}"
        kind_label = "📎 فایل" + (" + 💬 کپشن" if caption else "")

    # ۶. استیکر
    elif replied.sticker:
        identity_value = f"STICKER:{replied.sticker.file_id}"
        kind_label = "🎨 استیکر"

    # ۷. فقط متن
    elif replied.text:
        identity_value = replied.text.strip()
        kind_label = "📝 متن"

    if not identity_value:
        await message.reply_text(
            "⚠️ پیامی که ریپلای کردی هیچ محتوای قابل ثبت (متن، عکس، ویدیو، ویس، فایل، استیکر) نداره!"
        )
        return

    key = identity_key(chat.id, target.id)
    data["identities"][key] = identity_value[:4000]
    save_data()

    preview = identity_value[:100]
    await reply_and_delete(
        update,
        f"✅ هویت {target.first_name} ثبت شد.\n"
        f"نوع: {kind_label}\n\n"
        f"{preview}{'...' if len(identity_value) > 100 else ''}"
    )
def _split_identity(identity: str):
    """جدا کردن نوع، file_id و کپشن از رشته‌ی ذخیره‌شده"""
    prefix = ""
    file_id = ""
    caption = ""

    if ":" in identity and not identity.startswith("PHOTO:") is False:
        pass

    for p in ("PHOTO", "VIDEO", "VIDEO_NOTE", "VOICE", "DOCUMENT", "STICKER"):
        if identity.startswith(f"{p}:"):
            prefix = p
            rest = identity[len(p) + 1:]
            if "|CAPTION|" in rest:
                file_id, caption = rest.split("|CAPTION|", 1)
            else:
                file_id = rest
            return prefix, file_id, caption

    return None, "", identity  # متن خالص


