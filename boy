async def add_filter(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return
    parts = message.text.split(maxsplit=1) if message.text else []
    if len(parts) < 2 or not parts[1].strip():
        await message.reply_text("استفاده: /filter کلمه")
        return
    word = parts[1].strip().casefold()
    chat_id = str(chat.id)
    data["filters"].setdefault(chat_id, [])
    if word in data["filters"][chat_id]:
        await message.reply_text("این عبارت از قبل فیلتر شده است.")
        return
    data["filters"][chat_id].append(word)
    save_data()
    await message.reply_text(f"✅ عبارت «{word}» به فیلتر اضافه شد.")


async def remove_filter(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
