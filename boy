            await message.reply_text(
                f"🔄 XP کل گروه ریست شد.\n"
                f"👥 تعداد کاربران پاک‌شده: <b>{old_count}</b>",
                parse_mode="HTML",
            )
        return

    if len(parts) >= 3:
        action_word = None
        amount_str = None

        if parts[1] in ("بده", "کم", "کم کن") and parts[2].isdigit():
            action_word = "بده" if parts[1] == "بده" else "کم"
            amount_str = parts[2]
