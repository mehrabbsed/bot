async def set_custom_lock_text(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return

    parts = message.text.split(maxsplit=4)
    if len(parts) < 5:
        await message.reply_text("⚠️ متن رو بنویس. مثلا: `تنظیم متن قفل گروه گروه بسته شد`")
        return

    new_text = " ".join(parts[4:]).strip()
    data["custom_lock_text"][chat_key(chat.id)] = new_text
    save_data()

    await reply_and_delete(update, f"✅ متن قفل گروه به این تغییر کرد:\n\n{new_text}")


