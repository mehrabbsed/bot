@admin_only
async def date_command(update, context):
    message = update.effective_message
    if not message:
        return
    now = datetime.now()
    jalali = jdatetime.datetime.fromgregorian(datetime=now)
    jw = ["شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه"]
    gw = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    jm = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
          "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"]
    gm = ["January", "February", "March", "April", "May", "June",
          "July", "August", "September", "October", "November", "December"]
    jd = f"{jw[jalali.weekday()]} {jalali.day} {jm[jalali.month-1]} {jalali.year}"
    gd = f"{gw[now.weekday()]} {now.day} {gm[now.month-1]} {now.year}"
    clock = now.strftime("%H:%M:%S")

    h = now.hour
    if 5 <= h < 12:
        clock_emoji = "🌅"
        time_label = "صبح"
    elif 12 <= h < 17:
        clock_emoji = "☀️"
        time_label = "ظهر"
    elif 17 <= h < 20:
        clock_emoji = "🌇"
        time_label = "عصر"
    elif 20 <= h < 24:
        clock_emoji = "🌙"
        time_label = "شب"
    else:
        clock_emoji = "🌃"
        time_label = "نیمه‌شب"

    month = now.month
    if month in (3, 4, 5):
        season_emoji = "🌸"
        season = "بهار"
    elif month in (6, 7, 8):
        season_emoji = "☀️"
        season = "تابستان"
    elif month in (9, 10, 11):
        season_emoji = "🍂"
        season = "پاییز"
    else:
        season_emoji = "❄️"
        season = "زمستان"

    text = (
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"🇮🇷 <b>تاریخ شمسی</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"📅 {jd}\n"
        f"🔢 <code>{jalali.strftime('%Y/%m/%d')}</code>\n"
        f"{season_emoji} فصل: <b>{season}</b>\n\n"

        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"{clock_emoji} <b>ساعت</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"⏰ <code>{clock}</code>\n"
        f"🕐 {time_label}\n\n"

        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"🌍 <b>تاریخ میلادی</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━\n"
        f"📆 {gd}\n"
        f"🔢 <code>{now.strftime('%Y/%m/%d')}</code>"
