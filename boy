async def plain_mute_user(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    if not message or not message.text:
        return

    parts = message.text.split()

    if len(parts) > 1 and parts[1].isdigit():
        try:
            minutes = int(parts[1])
        except ValueError:
            await reply_and_delete(update, "❌ مدت باید عدد باشد؛ مثال: درتوبزار 5")
            return

        if not 1 <= minutes <= 10080:
            await reply_and_delete(update, "⚠️ مدت باید بین ۱ تا ۱۰۰۸۰ دقیقه باشد.")
            return

        context.user_data["plain_mute_minutes"] = minutes
        try:
            await mute_user(update, context)
        finally:
            context.user_data.pop("plain_mute_minutes", None)
    else:
        await mute_user(update, context)


