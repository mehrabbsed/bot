            if amount <= 0:
                await reply_and_delete(update, "⚠️ عدد باید مثبت باشه.")
                return
            if amount > 100000:
                await reply_and_delete(update, "⚠️ حداکثر ۱۰۰,۰۰۰.")
                return

            old_xp = get_user_xp(chat.id, target.id)
            old_level, _, _ = xp_to_level(old_xp)

            if action_word == "بده":
                new_xp = old_xp + amount
                action_text = "اضافه"
                sign = "+"
            else:
                new_xp = max(0, old_xp - amount)
                action_text = "کم"
                sign = "-"

            set_user_xp(chat.id, target.id, new_xp)
            save_data()
            new_level, _, _ = xp_to_level(new_xp)

            level_change = ""
            if new_level != old_level:
