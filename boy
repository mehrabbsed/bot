@admin_only
async def download_command(update, context):
    message = update.effective_message
    if not message:
        return
    text = message.text or ""
    parts = text.split(maxsplit=1)
    if len(parts) < 2:
        await message.reply_text("⚠️ استفاده: `دانلود لینک`")
        return
    url = parts[1].strip()
    if not url.startswith(("http://", "https://")):
        await message.reply_text("⚠️ لینک معتبر نیست.")
        return
    try:
        import yt_dlp
    except ImportError:
        await message.reply_text("⚠️ `yt-dlp` نصب نیست.\n`pip install yt-dlp`")
        return
    status_msg = await message.reply_text("⏳ در حال دانلود...")
    out_dir = Path("downloads")
    out_dir.mkdir(exist_ok=True)
    try:
        def _download():
            ydl_opts = {
                "outtmpl": str(out_dir / "%(title).50s.%(ext)s"),
                "format": "best[filesize<50M]/best",
                "noplaylist": True,
                "quiet": True,
            }
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(url, download=True)
                return ydl.prepare_filename(info)
        filepath = await asyncio.to_thread(_download)
        p = Path(filepath)
        if not p.exists():
            await status_msg.edit_text("❌ فایل دانلود نشد.")
            return
        if p.stat().st_size > 50 * 1024 * 1024:
            await status_msg.edit_text("⚠️ فایل > ۵۰MB.")
            p.unlink(missing_ok=True)
            return
        try:
            with open(p, "rb") as f:
                await message.reply_document(document=f, filename=p.name)
        finally:
            p.unlink(missing_ok=True)
        await status_msg.delete()
    except Exception as e:
        logger.exception(f"{e}")
        try:
            await status_msg.edit_text(f"❌ خطا: {str(e)[:200]}")
        except TelegramError:
            pass


