def _split_identity(identity):
    for p in ("PHOTO", "VIDEO", "VIDEO_NOTE", "VOICE", "DOCUMENT", "STICKER"):
        if identity.startswith(f"{p}:"):
            rest = identity[len(p) + 1:]
            if "|CAPTION|" in rest:
                fid, cap = rest.split("|CAPTION|", 1)
            else:
                fid, cap = rest, ""
            return p, fid, cap
    return None, "", identity


