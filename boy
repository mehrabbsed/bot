            amount_str = parts[1]
            action_word = "بده" if parts[2] == "بده" else "کم"
        elif len(parts) >= 4 and parts[1].isdigit() and parts[2] == "کم" and parts[3] == "کن":
            amount_str = parts[1]
            action_word = "کم"

