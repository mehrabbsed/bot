async def add_filter(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return
    parts = message.text.split(maxsplit=1) if message.text else []
    if len(parts) < 2 or not parts[1].strip():
        await message.reply_text("استفاده: /filter کلمه")
        return
    word = parts[1].strip().casefold()
    chat_id = str(chat.id)
    data["filters"].setdefault(chat_id, [])
    if word in data["filters"][chat_id]:
        await message.reply_text("این عبارت از قبل فیلتر شده است.")
        return
    data["filters"][chat_id].append(word)
    save_data()
    await message.reply_text(f"✅ عبارت «{word}» به فیلتر اضافه شد.")


async def remove_filter(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return
    parts = message.text.split(maxsplit=1) if message.text else []
    if len(parts) < 2 or not parts[1].strip():
        await message.reply_text("استفاده: /unfilter کلمه")
        return
    word = parts[1].strip().casefold()
    chat_id = str(chat.id)
    words = data["filters"].setdefault(chat_id, [])
    if word not in words:
        await message.reply_text("این عبارت در فهرست فیلترها نیست.")
        return
    words.remove(word)
    save_data()
    await message.reply_text(f"✅ عبارت «{word}» از فیلتر حذف شد.")


async def list_filters(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    if not message or not chat:
        return
    if not await require_admin(update, context):
        return
    words = data["filters"].get(str(chat.id), [])
    if not words:
        await message.reply_text("فهرست فیلترها خالی است.")
        return
    await message.reply_text("🚫 عبارت‌های فیلترشده:\n" + "\n".join(f"• {w}" for w in words))


async def check_filter(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return

    # 🔒 چک گروه مجاز
    if not is_allowed_chat(chat.id):
        return

    if user.is_bot:
        return
    if not message.text:
        return

    # ⚠️ اگه پیام با دستورات ناشناس شروع می‌شه، رد کن
    if message.text.startswith(("/anon", "ناشناس", "پیام مخفی", "/", "تگ")):
        return

    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        return

    text_to_check = message.text.casefold()
    words = data["filters"].get(str(chat.id), [])
    for word in words:
        if word and word in text_to_check:
            try:
                await message.delete()
            except TelegramError:
                pass
            return

    ck = chat_key(chat.id)
    uk = user_key(user.id)

    data.setdefault("last_messages", {})
    last_msg = data["last_messages"].get(f"{ck}:{uk}")

    if last_msg and last_msg.lower() == message.text.lower():
        data["warns"].setdefault(ck, {})
        current = int(data["warns"][ck].get(uk, 0))
        new_count = current + 1

        if new_count == 1:
            data["warns"][ck][uk] = 1
            warn_text = (
                "زهر اول: اولین قطره‌ی زهر وارد پرونده شد؛ دفعه‌ی بعد، عواقبش با خودته. 🥀\n\n"
                f"⚠️ اخطار: 1 از ۳\n"
                f"👤 کاربر: {user.mention_html()}\n"
                f"🆔 آیدی: <code>{user.id}</code>"
            )

        elif new_count == 2:
            data["warns"][ck][uk] = 2
            warn_text = (
                "🦂 زهر دوم: زهر دوم هم ثبت شد؛ فقط یک قدم تا حذف از این قلمرو فاصله داری. ☠️\n\n"
                f"⚠️ اخطار: 2 از ۳\n"
                f"👤 کاربر: {user.mention_html()}\n"
                f"🆔 آیدی: <code>{user.id}</code>"
            )

        else:
            try:
                await context.bot.ban_chat_member(chat.id, user.id)
                data["warns"][ck][uk] = 0
                warn_text = (
                    "🦂 زهر سوم: سه قطره زهر، یک حکم قطعی! ⚖️\n"
                    "🚫 مهلتت تموم شد؛ از این قلمرو اخراج شدی.\n\n"
                    f"👤 کاربر: {user.mention_html()}\n"
                    f"🆔 آیدی: <code>{user.id}</code>"
                )
            except TelegramError as e:
                logger.exception(f"خطا در بن: {e}")
                warn_text = f"❌ خطا در اجرای حکم: {e}"

        try:
            await message.delete()
        except TelegramError:
            pass

        try:
            await message.reply_text(warn_text, parse_mode="HTML")
        except TelegramError:
            try:
                await context.bot.send_message(chat.id, warn_text, parse_mode="HTML")
            except TelegramError as e:
                logger.exception(f"خطا در ارسال هشدار: {e}")

        save_data()
        data["last_messages"][f"{ck}:{uk}"] = None

    else:
        data["last_messages"][f"{ck}:{uk}"] = message.text
        save_data()


